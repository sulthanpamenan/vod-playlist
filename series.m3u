#EXTINF:-1 vod="1" type="series" content-type="series" tvg-tmdb="" tvg-description="Sinopsis: Chef lagi lanjutin baca novel di rumahnya. Sambil baca, chef kepikiran untuk menyeruput kopi susu kelapa yang bikin segar." director="Surya Pradito" cast="Gita Astika Apriliany" serie-title="SECRET CHEF" tvg-season="01" tvg-episode="04" tvg-logo="https://picture.dens.tv/poster/files/port/thumbnail_PORTRAIT-VOD-per-Episode-EPS.-33---Kopi-Susu-Kelapa.jpg" group-title="SECRET CHEF",S01E04 - Kopi Susu Kelapa
