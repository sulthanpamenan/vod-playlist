#EXTINF:-1 vod="1" type="series" content-type="series" tvg-tmdb="" tvg-description="Tomkuu dan Mars, dua orang sahabat kecil yang terpisahkan dari jarak dan waktu kembali bertemu di sebuah tempat terbengkalai yang mencekam. Tomkuu adalah seorang “spirit ilustrator” yang gemar melukis tempat mistis. Sedangkan Mars seorang wanita yang terlahirkan dengan kemampuan supranatural." director="Surya Pradito" cast="Tomkuu, Mars Duwiry" serie-title="Gerbang Dimensi" tvg-season="01" tvg-episode="02" tvg-logo="https://picture.dens.tv/poster/files/port/Thumbnail-VOD-Portrait-Gerbang-Dimensi-Part-2.jpg" group-title="Gerbang Dimensi",S01E02 - (Part 2)
