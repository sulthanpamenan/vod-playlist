#EXTINF:-1 vod="1" type="series" content-type="series" tvg-tmdb="" tvg-description="It's the Texas Dolly show, ya'll! World famous poker player Doyle Brunson shows the table at Bellagio Casino who put the "Texas" in Texas Hold 'Em. The legendary Poker Hall Of Famer is in the locker room swapping stories with some of his poker buddies and schooling the new kids." serie-title="PPT Professional Poker Tour" tvg-season="01" tvg-episode="17" tvg-logo="https://gizmeon.mdc.akamaized.net/PUB-50183/thumbnails/360_540/1788520400863-v2.jpg" group-title="PPT Professional Poker Tour",S01E17 - PPT - S01 E17: Bellagio - 3rd Quarter
