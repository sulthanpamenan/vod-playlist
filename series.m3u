#EXTINF:-1 vod="1" type="series" content-type="series" tvg-tmdb="" tvg-description="Perjalanan kali ini membawa Astriza pada sebuah Masjid bersejarah yang memiliki tiga budaya dalam satu bangunannya yaitu Masjid Hidayatullah yang terletak di Setiabudi, Jakarta Selatan." director="Surya Pradito" cast="Astriza" serie-title="Halal Kuliner" tvg-season="01" tvg-episode="12" tvg-logo="https://picture.dens.tv/poster/files/port/04.%20Portrait-VOD-Per-episode_Halal-Kuliner.jpg" group-title="Food",S01E12 - Cita Rasa India (Part 1)
