#EXTINF:-1 vod="1" type="series" content-type="series" tvg-tmdb="" tvg-description="Chusen mencoba berbagai resep dan bumbu yang cocok untuk memasak steak Tomahawk Australian Wagyu. Suhu daging yang tepat menjadi salah satu penanda kematangan dari daging. Steak ini ia sajikan untuk sepupunya yang akan datang dan belajar tentang berbagai tanaman hidroponik." director="Surya Pradito" cast="Chusen Aun" serie-title="Meat and Great" tvg-season="01" tvg-episode="08" tvg-logo="https://picture.dens.tv/poster/files/port/11-Portrait-VOD-Per-episode_Meat-and-Great.jpg" group-title="Meat and Great",S01E08 - Urban Gardener (Part 2)
